{
  "expo": {
    "name": "Dram",
    "slug": "dram",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dram",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.dram.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Dram uses the camera to identify whiskey labels and scan event QR codes.",
        "NSPhotoLibraryUsageDescription": "Dram lets you attach photos of bottles and pours to your tasting notes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.dram.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C8792A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Dram uses the camera to identify whiskey labels and scan event QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dram lets you attach photos of bottles and pours to your tasting notes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8792A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C8792A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
