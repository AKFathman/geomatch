# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app —
# only the anon key belongs here, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional: identify-label edge function lives at $EXPO_PUBLIC_SUPABASE_URL/functions/v1/identify-label
